  "partitions": [
    {"name": "nvs", "type": "data/nvs", "offset": "0x9000", "size": "64KB"},
    {"name": "phy_init", "type": "data/phy", "offset": "0x19000", "size": "4KB"},
    {"name": "factory", "type": "app/factory", "offset": "0x20000", "size": "4MB"},
    {"name": "registry", "type": "data/nvs", "offset": "0x420000", "size": "128KB"},
    {"name": "storage", "type": "data/custom", "offset": "0x440000", "size": "27.75MB"}
  ],
  "entryPoints": {
    "mqttDown": "iot/v1/{gatewayId}/down",
    "mqttUp": "iot/v1/{gatewayId}/up",
    "mqttPresence": "iot/v1/{gatewayId}/presence",
    "websocket": "ws://<网关地址>/ble/v1",
    "mdns": "_blegw._tcp",
    "configPortal": "http://192.168.4.1/ (AP SSID BTGW-XXXXXX)"
  },
  "protocol": {
    "version": 1,
    "operations": ["scan", "connect", "disconnect", "read", "write", "subscribe", "batch", "snapshot", "manage"],
    "reservedOperations": ["discover", "waitNotify"],
    "requireRegistration": true,
    "batchConnect": true,
    "managementActions": ["status", "backup", "save", "upsert", "remove", "pause", "resume", "diagnostics", "config.get", "config.set", "restart"],
    "errorCodes": {
      "0": "OK",
      "1001": "INVALID_REQUEST",
      "1002": "UNSUPPORTED_OP",
      "1003": "INVALID_ARGUMENT",
      "2001": "GATEWAY_BUSY",
      "2002": "QUEUE_TIMEOUT",
      "2003": "CONNECTION_LIMIT",
      "3001": "DEVICE_NOT_FOUND",
      "3002": "NOT_CONNECTED",
      "3003": "CONNECT_TIMEOUT",
      "3004": "DEVICE_NOT_REGISTERED",
      "3101": "DISCONNECTED",
      "4001": "SERVICE_NOT_FOUND",
      "4002": "CHAR_NOT_FOUND",
      "4101": "READ_FAILED",
      "4201": "WRITE_FAILED",
      "4301": "SUBSCRIBE_FAILED",
      "4901": "GATT_TIMEOUT",
      "4999": "SKIPPED"
    }
  },
  "management": {
    "transport": "与设备控制共用 iot/v1/{gatewayId}/down|up，不额外增加主题",
    "mutuallyExclusiveWrites": true,
    "restartIsDeferred": true,
    "passwordsOmitted": true
  },
  "notes": [
    "只连接用户登记过的设备，扫描结果不会触发连接",
    "合并固件从 0x0 写入，覆盖 NVS 与分区表，烧录后需要重新配网并重新登记设备",
    "registry 分区在 0x420000，未被合并镜像覆盖，如内容异常网关会自动忽略并记录 loadError",
    "0.7.0 新增 manage 管理通道：登记增删改、暂停恢复、诊断、网络配置与重启均通过 MQTT 下发",
    "0.7.0 统一 hello 与 diagnostics 上报的固件版本号，此前 diagnostics 误报 0.1.0"
  ]
}
