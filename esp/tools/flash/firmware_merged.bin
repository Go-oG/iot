        <div class="card">
          <span class="muted">BLE å·²è¿æ¥ / ä¸Šé™</span
          ><strong id="links">â€”</strong
          ><span id="pending" class="muted">â€”</span>
        </div>
        <div class="card">
          <span class="muted">å†…éƒ¨ RAM å¯ç”¨</span><strong id="heap">â€”</strong
          ><span id="minimum" class="muted">â€”</span>
        </div>
        <div class="card">
          <span class="muted">PSRAM å¯ç”¨</span><strong id="psram">â€”</strong
          ><span id="psramTotal" class="muted">â€”</span>
        </div>
        <div class="card">
          <span class="muted">MQTT å‘é€ç¼“å­˜</span><strong id="outbox">â€”</strong
          ><span id="mqtt" class="muted">â€”</span>
        </div>
      </div>
      <section>
        <div class="section-head">
          <h2>å·²ç™»è®°è®¾å¤‡ <span id="count" class="muted">0 / 32</span></h2>
          <div class="toolbar">
            <a class="button" href="/api/backup" download>å¯¼å‡ºè®¾å¤‡é…ç½®</a
            ><button id="import">å¯¼å…¥é…ç½®</button
            ><input
              id="file"
              type="file"
              accept="application/json,.json"
              hidden
            /><button id="add" class="primary">æ·»åŠ è®¾å¤‡</button>
          </div>
        </div>
        <p class="footnote">
          è¿æ¥å‹è®¾å¤‡è‡ªåŠ¨æ¢å¤è¿æ¥ä¸è®¢é˜…ï¼›å¹¿æ’­å‹è®¾å¤‡å®šæœŸç›‘å¬ï¼Œä¸å ç”¨è¿æ¥åé¢ã€‚æš‚åœçŠ¶æ€ä»…åœ¨æœ¬æ¬¡è¿è¡Œä¸­æœ‰æ•ˆã€‚
        </p>
        <div class="scroll">
          <table>
            <thead>
              <tr>
                <th>è®¾å¤‡</th>
                <th>çŠ¶æ€ / ä¿¡å·</th>
                <th>è®¢é˜… / è¿æ¥é—´éš”</th>
                <th>æ”¶å– / å‘é€</th>
                <th>å…¥é˜Ÿå¤±è´¥</th>
                <th>è¯Šæ–­</th>
                <th>æ“ä½œ</th>
              </tr>
            </thead>
            <tbody id="devices"></tbody>
          </table>
        </div>
        <div id="empty" class="empty">
          å°šæœªç™»è®°è®¾å¤‡ã€‚å¯æ‰‹åŠ¨æ·»åŠ ï¼Œæˆ–ä»é™„è¿‘è®¾å¤‡ä¸­é€‰æ‹©ã€‚
        </div>
        <details>
          <summary>ç½‘å…³è¯¦ç»†è¯Šæ–­</summary>
          <p id="diagExtra"></p>
        </details>
      </section>
      <section>
        <div class="section-head">
          <h2>é™„è¿‘è®¾å¤‡</h2>
          <button id="scan">æ‰«æ 5 ç§’</button>
        </div>
        <p class="footnote">
          æ‰«æè¯·æ±‚ä¼šç­‰å¾…å½“å‰è¿æ¥å°è¯•ç»“æŸã€‚åˆ—è¡¨æœ€å¤šä¿ç•™ 64 å°æœ€è¿‘å‘ç°çš„è®¾å¤‡ã€‚
        </p>
        <div class="scroll">
          <table>
            <thead>
              <tr>
                <th>å¹¿æ’­åç§° / åœ°å€</th>
                <th>åœ°å€ç±»å‹</th>
                <th>RSSI</th>
                <th>æœ€è¿‘å‘ç°</th>
                <th></th>
              </tr>
