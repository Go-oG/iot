    <style>
      :root {
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        color: #17292b;
        background: #f1f5f4;
        font-size: 14px;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
      }
      main {
        max-width: 1320px;
        margin: auto;
        padding: 28px;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      h1 {
        font-size: 26px;
        margin: 8px 0;
      }
      h2 {
        font-size: 18px;
        margin: 0;
      }
      p {
        line-height: 1.65;
        color: #526768;
      }
      .eyebrow {
        font-size: 11px;
        letter-spacing: 2px;
        color: #387570;
      }
      a {
        color: #11665e;
      }
      .toolbar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
      }
      button,
      .button {
        font: inherit;
        cursor: pointer;
        padding: 9px 13px;
        border: 1px solid #c5d4cf;
        border-radius: 8px;
        background: #fff;
        color: #204841;
        text-decoration: none;
      }
      button.primary {
        background: #16685d;
        color: white;
        border-color: #16685d;
      }
      button.danger {
        color: #a23434;
      }
      button:disabled {
        opacity: 0.5;
        cursor: wait;
      }
      .cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin: 24px 0;
      }
      .card,
      section {
        background: #fff;
        border: 1px solid #dce5e1;
        border-radius: 12px;
      }
      .card {
        padding: 18px;
      }
      .card strong {
        display: block;
        font-size: 25px;
        margin: 8px 0;
      }
      .muted {
        color: #647a75;
        font-size: 12px;
      }
      section {
        padding: 20px;
        margin-bottom: 16px;
      }
      .section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .scroll {
        overflow: auto;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        margin-top: 14px;
        white-space: nowrap;
      }
      th,
      td {
        padding: 12px 9px;
        border-bottom: 1px solid #e5ece8;
        text-align: left;
      }
      th {
        font-size: 12px;
        color: #667a75;
        font-weight: 500;
      }
      td.name {
        min-width: 170px;
      }
      td small {
        display: block;
        color: #778984;
        font-family: monospace;
        margin-top: 4px;
      }
      .pill {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 20px;
        background: #edf3f0;
        color: #526b63;
      }
      .pill.online {
        background: #dff2e9;
        color: #196749;
      }
      #message {
        position: sticky;
        top: 8px;
        z-index: 3;
        border-radius: 8px;
        padding: 12px;
        background: #fff1d9;
        color: #704807;
        margin: 12px 0;
        display: none;
      }
      .empty {
        text-align: center;
        padding: 30px;
        color: #6b8178;
      }
      dialog {
        border: 1px solid #c5d4cf;
        border-radius: 12px;
        width: min(650px, 95vw);
        padding: 24px;
        max-height: 92vh;
      }
      dialog::backdrop {
        background: #142b2666;
      }
      label {
        display: block;
        margin-top: 14px;
        color: #425f54;
      }
      input,
      select,
      textarea {
        font: inherit;
        width: 100%;
        padding: 9px;
        border: 1px solid #bccfc5;
        border-radius: 6px;
        margin-top: 5px;
        background: white;
      }
      input[type="checkbox"] {
        width: auto;
        margin: 0 6px 0 0;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      textarea {
        font-family: monospace;
        min-height: 110px;
      }
      dialog .toolbar {
        justify-content: flex-end;
        margin-top: 22px;
      }
      .footnote {
        font-size: 12px;
        color: #60796c;
        margin: 12px 0 0;
      }
      #connection {
        font-size: 12px;
      }
      details {
        margin-top: 14px;
      }
      #diagExtra {
        white-space: pre-wrap;
        font-family: monospace;
        font-size: 12px;
      }
      @media (max-width: 740px) {
        main {
          padding: 16px;
        }
        header {
          align-items: flex-start;
          flex-direction: column;
        }
        .cards {
          grid-template-columns: 1fr 1fr;
        }
        .grid {
          grid-template-columns: 1fr;
        }
        .section-head {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
