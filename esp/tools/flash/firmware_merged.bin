        </div>
      </section>
      <p class="footnote">
        ä¿å­˜æˆ–å¯¼å…¥ä¼šæ›¿æ¢è®¾å¤‡æ¸…å•å¹¶é‡å¯ç”Ÿæ•ˆã€‚å¤‡ä»½ä»…å«è®¾å¤‡ç™»è®°ä¸è®¢é˜…ç­–ç•¥ï¼Œä¸åŒ…å«
        Wi-Fi / MQTT å¯†ç ã€‚è¯¥é¢æ¿ç”¨äºå¯ä¿¡å±€åŸŸç½‘ã€‚
      </p>
    </main>
    <dialog id="editor">
      <form id="deviceForm">
        <h2 id="editorTitle">æ·»åŠ è®¾å¤‡</h2>
        <div class="grid">
          <label
            >åç§°<input
              id="alias"
              maxlength="48"
              required
              placeholder="ä¾‹å¦‚ï¼šå®¢å…æ¸©åº¦è®¡" /></label
          ><label
            >è“ç‰™åœ°å€<input
              id="address"
              required
              pattern="[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}"
              placeholder="AA:BB:CC:DD:EE:FF"
          /></label>
        </div>
        <div class="grid">
          <label
            >å·¥ä½œæ–¹å¼<select id="mode">
              <option value="connection">æŒç»­è¿æ¥ï¼Œè‡ªåŠ¨é‡è¿</option>
              <option value="broadcast">å¹¿æ’­ç›‘å¬</option>
            </select></label
          ><label
            >åœ°å€ç±»å‹<select id="addressType">
              <option value="0">Publicï¼ˆ0ï¼‰</option>
              <option value="1">Randomï¼ˆ1ï¼‰</option>
              <option value="2">RPA Publicï¼ˆ2ï¼‰</option>
              <option value="3">RPA Randomï¼ˆ3ï¼‰</option>
            </select></label
          >
        </div>
        <label><input id="enabled" type="checkbox" checked />å¯ç”¨è®¾å¤‡</label>
        <div class="grid">
          <label
            >æœ€å°è¿æ¥é—´éš”ï¼ˆmsï¼‰<input
              id="intervalMin"
              type="number"
              min="15"
              max="4000"
              step="5"
              value="100"
              required /></label
          ><label
            >æœ€å¤§è¿æ¥é—´éš”ï¼ˆmsï¼‰<input
              id="intervalMax"
              type="number"
              min="15"
              max="4000"
              step="5"
              value="200"
              required
          /></label>
        </div>
        <div class="grid">
          <label
            >ä¸ŠæŠ¥å¤„ç†<select id="reportMode">
              <option value="latest">ä¿ç•™æ¯ä¸ªç‰¹å¾çš„æœ€æ–°å€¼</option>
              <option value="stream">æŒ‰é¡ºåºä¼ é€’æ¯æ¡é€šçŸ¥</option>
            </select></label>
        </div>
        <label
          >è‡ªåŠ¨æ¢å¤çš„è®¢é˜…ï¼ˆæœ€å¤š 4 æ¡ï¼‰<textarea
            id="subscriptions"
            placeholder="æ¯è¡Œï¼šæœåŠ¡UUID ç‰¹å¾UUID notifyæˆ–indicate&#10;180F 2A19 notify"
          ></textarea>
        </label>
        <p class="footnote">
          æ¯å°è®¾å¤‡æœ€å¤šç¼“å†² 8 æ¡ï¼Œç½‘å…³è½®è½¬å‘é€ï¼Œæœ€å¤šçº¦ 160
          æ¡/ç§’ã€‚é€æ¡æ¨¡å¼ä¹Ÿå—é˜Ÿåˆ—å®¹é‡å’Œ MQTT å¯ç”¨æ€§é™åˆ¶ã€‚å¹¿æ’­ç›‘å¬æ— éœ€å¡«å†™è®¢é˜…ã€‚
        </p>
        <div id="formError" role="alert" style="color: #a23434"></div>
        <div class="toolbar">
          <button type="button" id="cancel">å–æ¶ˆ</button
          ><button class="primary" type="submit">ä¿å­˜å¹¶é‡å¯</button>
        </div>
      </form>
    </dialog>
    <script>
      "use strict";
      const $ = (id) => document.getElementById(id);
      let registry = { version: 1, devices: [] },
        editing = -1,
        busy = false,
        refreshing = false,
        rebooting = false;
      const states = {
        disabled: "å·²ç¦ç”¨",
        paused: "å·²æš‚åœ",
        broadcast: "å¹¿æ’­ç›‘å¬",
        connected: "å·²è¿æ¥",
        connecting: "è¿æ¥ä¸­",
        backoff: "ç­‰å¾…é‡è¿",
      };
      const size = (n) =>
        Number.isFinite(n) ? (n / 1024).toFixed(1) + " KiB" : "â€”";
      function message(text) {
        $("message").textContent = text;
        $("message").style.display = text ? "block" : "none";
      }
      async function api(path, body) {
        const r = await fetch(
          path,
          body === undefined
            ? { cache: "no-store" }
            : {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body),
              },
        );
        const j = await r.json();
        if (!r.ok || j.ok === false) throw Error(j.error || "è¯·æ±‚å¤±è´¥");
        return j;
      }
      function cell(row, text) {
        const el = document.createElement("td");
        el.textContent = text;
        row.append(el);
        return el;
      }
      function button(parent, text, fn) {
        const b = document.createElement("button");
        b.textContent = text;
        b.addEventListener("click", () =>
          Promise.resolve(fn()).catch((e) => message(e.message)),
        );
        parent.append(b);
        return b;
      }
      function renderDevices(data) {
        registry = { version: 1, devices: data.devices };
        $("count").textContent = data.devices.length + " / 32";
        $("empty").hidden = !!data.devices.length;
        $("devices").replaceChildren();
        data.devices.forEach((d, i) => {
          const r = data.states.find((s) => s.device === d.device) || {},
            tr = document.createElement("tr");
          const name = cell(tr, d.alias || d.device);
          name.className = "name";
          const mac = document.createElement("small");
          mac.textContent = d.device;
          name.append(mac);
          const state = cell(tr, "");
          const badge = document.createElement("span");
          badge.className = "pill" + (r.state === "connected" ? " online" : "");
          badge.textContent = states[r.state] || "æœªçŸ¥";
          state.append(badge);
          const signal = document.createElement("small");
          signal.textContent =
            r.rssi === undefined ? "RSSI æœªçŸ¥" : r.rssi + " dBm";
          state.append(signal);
          cell(
            tr,
            (r.restoredSubscriptions || 0) +
              " / " +
              d.subscriptions.length +
              " Â· " +
              (r.actualIntervalMs || "â€”") +
              " ms",
          );
          cell(tr, (r.received || 0) + " / " + (r.published || 0));
          cell(tr, r.dropped || 0);
          const diagnostic = cell(tr, "");
          diagnostic.textContent = r.lastError
            ? (r.lastErrorText || "é”™è¯¯") + " (" + r.lastError + ")"
            : r.servicesReady
              ? "æœåŠ¡å°±ç»ª"
              : "â€”";
          const detail = document.createElement("small");
          detail.textContent =
            "é‡è¯• " +
            Math.ceil((r.retryInMs || 0) / 1000) +
            "s" +
            (r.intervalStatus ? " Â· é—´éš”é”™è¯¯ " + r.intervalStatus : "");
          diagnostic.append(detail);
          const ops = cell(tr, "");
          ops.className = "toolbar";
          button(ops, r.paused ? "æ¢å¤" : "æš‚åœ", () =>
            api("/api/action", {
              op: r.paused ? "resume" : "pause",
              device: d.device,
            }).then(refresh),
          );
          button(ops, "ç¼–è¾‘", () => edit(i));
          button(ops, "åˆ é™¤", async () => {
            if (confirm("åˆ é™¤ " + (d.alias || d.device) + " å¹¶é‡å¯ç½‘å…³ï¼Ÿ"))
              await save({
                version: 1,
                devices: registry.devices.filter((_, n) => n !== i),
              });
          }).className = "danger";
          $("devices").append(tr);
        });
        if (data.loadError)
          message(
            "è®¾å¤‡é…ç½®åŠ è½½å¤±è´¥ï¼š" +
              data.loadError +
              "ã€‚è¯·æ£€æŸ¥åˆ†åŒºæ˜¯å¦å®Œæ•´çƒ§å½•ï¼Œæˆ–é‡æ–°å¯¼å…¥å¤‡ä»½ã€‚",
          );
      }
      function renderSeen(data) {
        $("seen").replaceChildren();
        data.devices
          .sort((a, b) => a.lastSeenAgoMs - b.lastSeenAgoMs)
          .forEach((d) => {
            const tr = document.createElement("tr");
            const name = cell(tr, d.name || "æœªæä¾›åç§°");
            const mac = document.createElement("small");
            mac.textContent = d.device;
            name.append(mac);
            cell(tr, d.addressType);
            cell(tr, d.rssi + " dBm");
            cell(tr, Math.floor(d.lastSeenAgoMs / 1000) + " ç§’å‰");
            const ops = cell(tr, "");
            const exists = registry.devices.some((x) => x.device === d.device);
            if (exists) ops.textContent = "å·²ç™»è®°";
            else button(ops, "ç™»è®°", () => edit(-1, d));
            $("seen").append(tr);
          });
      }
      async function refresh() {
        if (refreshing || rebooting) return;
        refreshing = true;
        try {
          const [d, g, s] = await Promise.all([
            api("/api/devices"),
            api("/api/diagnostics"),
            api("/api/seen"),
          ]);
          renderDevices(d);
          renderSeen(s);
          $("links").textContent =
            g.connectedDevices + " / " + g.maxBleConnections;
          $("pending").textContent = g.connectingDevices + " å°æ­£åœ¨è¿æ¥";
          $("heap").textContent = size(g.freeInternalHeapBytes);
          $("minimum").textContent =
            "è¿è¡Œæœ€ä½ " + size(g.minimumInternalHeapBytes);
          $("psram").textContent = size(g.freePsramHeapBytes);
          $("psramTotal").textContent = "å®¹é‡ " + size(g.psramSizeBytes);
          $("outbox").textContent = size(g.mqttOutboxBytes);
          $("mqtt").textContent = g.mqttConnected
            ? "MQTT å·²è¿æ¥"
            : "MQTT æœªè¿æ¥";
          $("connection").textContent =
            "å›ºä»¶ " +
            g.firmware +
            " Â· å·²è¿è¡Œ " +
            Math.floor(g.uptimeMs / 60000) +
            " åˆ†é’Ÿ Â· åˆšåˆšæ›´æ–°";
          $("diagExtra").textContent =
            "Flash: " +
            size(g.flashSizeBytes) +
            "\nå†…éƒ¨æœ€å¤§è¿ç»­å—: " +
            size(g.largestInternalBlockBytes) +
            "\nWi-Fi: " +
            (g.wifiConnected ? "å·²è¿æ¥" : "æœªè¿æ¥");
        } catch (e) {
          $("connection").textContent = "æ— æ³•è¿æ¥ç½‘å…³ Â· " + e.message;
        } finally {
          refreshing = false;
        }
      }
      function edit(index, seen) {
        if (busy) return;
        if (index < 0 && registry.devices.length >= 32) {
          message("æœ€å¤šç™»è®° 32 å°è®¾å¤‡");
          return;
        }
        editing = index;
        const d =
          index >= 0
            ? registry.devices[index]
            : {
                alias: seen?.name || "",
                device: seen?.device || "",
                addressType: seen?.addressType || 0,
                mode: "connection",
                enabled: true,
                intervalMinMs: 100,
                intervalMaxMs: 200,
                reportMode: "latest",
                subscriptions: [],
              };
        $("editorTitle").textContent = index < 0 ? "æ·»åŠ è®¾å¤‡" : "ç¼–è¾‘è®¾å¤‡";
        $("alias").value = d.alias;
        $("address").value = d.device;
        $("addressType").value = d.addressType;
        $("mode").value = d.mode;
        $("enabled").checked = d.enabled;
        $("intervalMin").value = d.intervalMinMs;
        $("intervalMax").value = d.intervalMaxMs;
        $("reportMode").value = d.reportMode;
        $("subscriptions").value = d.subscriptions
          .map(
            (s) =>
              s.service +
              " " +
              s.characteristic +
              " " +
              (s.indicate ? "indicate" : "notify"),
          )
          .join("\n");
        $("formError").textContent = "";
        $("editor").showModal();
      }
      async function save(config) {
        if (busy) return;
        busy = true;
        try {
          await api("/api/devices", config);
          $("editor").close();
          rebooting = true;
          message(
            "è®¾å¤‡é…ç½®å·²ä¿å­˜ï¼Œç½‘å…³æ­£åœ¨é‡å¯ã€‚çº¦ 10 ç§’åè‡ªåŠ¨åˆ·æ–°ï¼›è‹¥ä»åœ¨é…ç½‘çƒ­ç‚¹ä¸­ï¼Œè¯·é‡æ–°è¿æ¥çƒ­ç‚¹ã€‚",
          );
          setTimeout(() => {
            rebooting = false;
            location.reload();
          }, 10000);
        } finally {
          busy = false;
        }
      }
      $("deviceForm").addEventListener("submit", async (e) => {
        e.preventDefault();
        try {
          if (new TextEncoder().encode($("alias").value).length > 48)
            throw Error("åç§°ä¸èƒ½è¶…è¿‡ 48 å­—èŠ‚ï¼Œä¸­æ–‡é€šå¸¸æ¯å­—å  3 å­—èŠ‚");
          const subs = $("subscriptions").value.trim()
            ? $("subscriptions")
                .value.trim()
                .split(/\n+/)
                .map((line) => {
                  const parts = line.trim().split(/\s+/);
                  if (
                    parts.length !== 3 ||
                    !["notify", "indicate"].includes(parts[2])
                  )
                    throw Error("è®¢é˜…æ ¼å¼ï¼šæœåŠ¡UUID ç‰¹å¾UUID notifyæˆ–indicate");
                  return {
                    service: parts[0],
                    characteristic: parts[1],
                    indicate: parts[2] === "indicate",
                  };
                })
            : [];
          if ($("mode").value === "broadcast" && subs.length)
            throw Error("å¹¿æ’­ç›‘å¬æ¨¡å¼è¯·æ¸…ç©ºè®¢é˜…");
          const d = {
            ...(editing >= 0 ? registry.devices[editing] : {}),
            alias: $("alias").value,
            device: $("address").value.toUpperCase(),
            addressType: Number($("addressType").value),
            mode: $("mode").value,
            enabled: $("enabled").checked,
            intervalMinMs: Number($("intervalMin").value),
            intervalMaxMs: Number($("intervalMax").value),
            reportMode: $("reportMode").value,
            subscriptions: subs,
          };
          if (d.intervalMinMs > d.intervalMaxMs)
            throw Error("æœ€å°è¿æ¥é—´éš”ä¸èƒ½å¤§äºæœ€å¤§å€¼");
          const devices = structuredClone(registry.devices);
          if (editing < 0) devices.push(d);
          else devices[editing] = d;
          await save({ version: 1, devices });
        } catch (err) {
          $("formError").textContent = err.message;
        }
      });
      $("cancel").onclick = () => $("editor").close();
      $("add").onclick = () => edit(-1);
      $("refresh").onclick = refresh;
      $("scan").onclick = async () => {
        try {
          await api("/api/action", { op: "scan" });
          message("æ‰«æå·²åŠ å…¥è°ƒåº¦ï¼Œå°†åœ¨å½“å‰è¿æ¥å°è¯•ç»“æŸåæ‰§è¡Œã€‚");
          setTimeout(refresh, 6000);
        } catch (e) {
          message(e.message);
        }
      };
      $("import").onclick = () => $("file").click();
      $("file").onchange = async () => {
        try {
          const file = $("file").files[0];
          if (!file) return;
          if (file.size > 32768) throw Error("å¤‡ä»½æ–‡ä»¶ä¸èƒ½è¶…è¿‡ 32 KiB");
          const data = JSON.parse(await file.text());
          if (
            data.version !== 1 ||
            !Array.isArray(data.devices) ||
            data.devices.length > 32
          )
            throw Error("å¤‡ä»½æ ¼å¼æˆ–ç‰ˆæœ¬ä¸æ­£ç¡®");
          if (
            confirm(
              "å¯¼å…¥å°†æ›¿æ¢å…¨éƒ¨è®¾å¤‡ç™»è®°ï¼ˆ" +
                data.devices.length +
                " å°ï¼‰å¹¶é‡å¯ï¼Œæ˜¯å¦ç»§ç»­ï¼Ÿ",
            )
          )
            await save(data);
        } catch (e) {
          message(e.message);
        } finally {
          $("file").value = "";
        }
      };
      refresh();
      setInterval(refresh, 3000);
    </script>
